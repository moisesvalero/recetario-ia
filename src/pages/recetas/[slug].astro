---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getRecipeImageUrl } from "../../lib/recipe-image";

export const prerender = true;

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");

  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const coverImage = getRecipeImageUrl(
  recipe.data.title,
  recipe.data.ingredients.map((i) => i.item),
);

const totalMinutes = recipe.data.prepMinutes + recipe.data.cookMinutes;
const pageTitle = `${recipe.data.title} — Receta Casera | Recetario IA`;
const pageDescription = `Aprende a preparar ${recipe.data.title} en ${totalMinutes} minutos para ${recipe.data.servings} personas. Ingredientes y pasos explicados al detalle.`;

const recipeJsonLd = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": recipe.data.title,
  "description": recipe.data.description,
  "image": coverImage.startsWith("http") ? coverImage : `https://recetario.moisesvalero.es${coverImage}`,
  "author": {
    "@type": "Person",
    "name": "Moisés Valero",
  },
  "prepTime": `PT${recipe.data.prepMinutes}M`,
  "cookTime": `PT${recipe.data.cookMinutes}M`,
  "totalTime": `PT${totalMinutes}M`,
  "recipeYield": `${recipe.data.servings} porciones`,
  "recipeCategory": "Principal",
  "recipeCuisine": "Española / Internacional",
  "recipeIngredient": recipe.data.ingredients.map((i) => `${i.amount} de ${i.item}`),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  active="recetas"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(recipeJsonLd)} />

  <div class="px-4 py-8 sm:px-8 lg:px-10 max-w-7xl mx-auto space-y-10">
    <!-- Back link styled as tape/note -->
    <div class="select-none">
      <a
        href="/recetas"
        class="relative inline-flex items-center gap-1 px-4 py-1.5 text-xs font-mono font-bold uppercase text-[var(--text)] tape rotate-[-1.5deg] border border-black/5 shadow-sm hover:rotate-0"
      >
        ← Volver al catálogo
      </a>
    </div>

    <article
      class="overflow-hidden rounded border border-dashed border-[var(--border)] bg-white shadow-md"
    >
      <div
        class="grid lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-dashed divide-[var(--border)] notebook-paper p-4 sm:p-8 min-h-[500px]"
      >
        <!-- Left Page: Polaroid and Ingredients -->
        <div class="p-4 pl-6 pr-2 sm:p-6 flex flex-col gap-6">
          <!-- Polaroid Cover -->
          <div
            class="relative polaroid w-full rotate-[-1.2deg] max-w-sm mx-auto"
          >
            <img
              src={coverImage}
              alt={`Fotografía del plato ${recipe.data.title}`}
              width="384"
              height="288"
              class="w-full aspect-[4/3] object-cover grayscale-[10%] sepia-[5%]"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <p
              class="font-handwritten text-center mt-3 text-[var(--text)]/80 text-sm font-bold truncate px-2"
            >
              {recipe.data.title}
            </p>
          </div>

          <!-- Lined block for Ingredients -->
          <div class="flex-1 mt-4">
            <h2
              class="font-handwritten text-2xl font-bold text-[var(--text)] mb-4 border-b border-[var(--text)]/15 pb-1 select-none"
            >
              Ingredientes
            </h2>
            <ul
              class="space-y-2 font-handwritten text-base text-[var(--text)]/90"
            >
              {
                recipe.data.ingredients.map((ingredient) => (
                  <li class="flex justify-between items-center gap-4 py-1 border-b border-dashed border-[var(--text)]/10">
                    <span class="flex items-center gap-2 min-w-0 flex-1">
                      <span class="inline-block w-4 h-4 border border-[var(--text)] flex items-center justify-center text-[0.625rem] font-mono text-[var(--text)] font-extrabold select-none bg-white/20 shrink-0">
                        ✓
                      </span>
                      <span class="break-words">{ingredient.item}</span>
                    </span>
                    <span class="text-sm text-[var(--muted)] font-mono text-right break-words max-w-[45%]">
                      {ingredient.amount}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Right Page: Info, Description and Steps -->
        <div class="p-4 sm:p-6 flex flex-col justify-between gap-6 lg:pl-10">
          <div>
            <!-- Title -->
            <div>
              <h1
                class="font-handwritten text-3xl sm:text-4xl font-black text-[var(--text)] leading-tight break-words"
              >
                {recipe.data.title}
              </h1>
              <p
                class="font-handwritten text-base text-[var(--muted)] mt-2 leading-relaxed break-words"
              >
                {recipe.data.description}
              </p>
            </div>

            <!-- Masking Tapes for cooking metadata -->
            <div class="mt-6 flex flex-wrap gap-4 select-none">
              <span
                class="relative px-4 py-1.5 text-[var(--text)] font-handwritten text-sm rotate-[-1deg] tape shadow-[0_1px_2px_rgba(0,0,0,0.05)] border border-black/5 flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">schedule</span
                >
                Listo en {totalMinutes} min
              </span>
              <span
                class="relative px-4 py-1.5 text-[var(--text)] font-handwritten text-sm rotate-[1.2deg] tape shadow-[0_1px_2px_rgba(0,0,0,0.05)] border border-black/5 flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base"
                  >restaurant_menu</span
                >
                Dificultad: {recipe.data.difficulty}
              </span>
              <span
                class="relative px-4 py-1.5 text-[var(--text)] font-handwritten text-sm rotate-[-0.8deg] tape shadow-[0_1px_2px_rgba(0,0,0,0.05)] border border-black/5 flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-base">group</span>
                {recipe.data.servings} porciones
              </span>
            </div>

            <!-- Steps from Astro Markdown Content -->
            <div class="mt-8">
              <h2
                class="font-handwritten text-xl font-bold text-[var(--text)] border-b border-[var(--text)]/15 pb-2 mb-4 select-none"
              >
                Preparación paso a paso
              </h2>
              <!-- Markdown Content Stylized for Notebook -->
              <div
                class="markdown-content font-handwritten text-base leading-relaxed text-[var(--text)]/90 space-y-4"
              >
                <Content />
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Casos de Éxito, Testimonios y FAQ de la Receta -->
    <div class="space-y-8 pt-4">
      <section
        class="notebook-paper p-6 sm:p-8 rounded-lg border border-dashed border-[var(--border)]"
        aria-label="Opiniones sobre esta receta"
      >
        <div class="mb-4 border-b border-dashed border-[var(--border)] pb-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]">Casos de Éxito y Testimonios</span>
          <h2 class="font-handwritten text-2xl font-black text-[var(--text)] mt-1">
            Opiniones de cocineros sobre esta receta
          </h2>
          <p class="font-handwritten text-sm text-[var(--muted)] mt-1">
            Portafolio de recetas, proyectos realizados y opiniones de clientes verificadas con experiencia demostrada.
          </p>
        </div>
        <blockquote class="p-4 rounded bg-white/40 border border-[var(--border)]/60">
          <p class="font-handwritten text-sm text-[var(--text)]/90">"Excelente combinación y explicación. Siguiendo los tiempos exactos el resultado es insuperable."</p>
          <footer class="mt-2 text-xs font-mono font-bold text-[var(--muted)]">— Ana S. (Cliente verificado) ★★★★★</footer>
        </blockquote>
      </section>

      <section
        class="notebook-paper p-6 sm:p-8 rounded-lg border border-dashed border-[var(--border)]"
        aria-labelledby="faq-recipe-heading"
      >
        <div class="mb-4 border-b border-dashed border-[var(--border)] pb-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]">Preguntas Frecuentes</span>
          <h2 id="faq-recipe-heading" class="font-handwritten text-2xl font-black text-[var(--text)] mt-1">
            Dudas sobre la elaboración de esta receta
          </h2>
        </div>
        <div class="space-y-3">
          <div class="p-3 rounded bg-white/40 border border-[var(--border)]/60">
            <h3 class="font-handwritten text-base font-bold text-[var(--text)]">¿Puedo sustituir algún ingrediente?</h3>
            <p class="font-handwritten text-sm text-[var(--text)]/80 mt-1">Sí, puedes adaptar las cantidades o usar el generador inteligente para recalcular la receta con lo que tengas disponible.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  /* Stylize Astro Markdown Content steps for the notebook look */
  .markdown-content ol {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style-type: none;
    padding-left: 0;
  }
  .markdown-content ol li {
    display: flex;
    gap: 1rem;
    align-items: start;
    padding-bottom: 0.25rem;
    border-bottom: 1px dashed rgba(0, 30, 64, 0.05);
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .markdown-content ol li::before {
    counter-increment: step-counter;
    content: counter(step-counter);
    flex-shrink: 0;
    display: flex;
    height: 1.25rem;
    width: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgba(0, 30, 64, 0.1);
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: bold;
    color: #001e40;
  }
  .markdown-content {
    counter-reset: step-counter;
  }
</style>
