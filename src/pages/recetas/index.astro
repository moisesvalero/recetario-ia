---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getRecipeImageUrl } from "../../lib/recipe-image";

export const prerender = true;

const recipes = (await getCollection("recipes")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "es"),
);
---

<Layout
  title="Catálogo de Recetas de Ejemplo — Recetario IA"
  description="Explora el catálogo de recetas seleccionadas de Recetario IA. Fichas de cocina fáciles, rápidas y estructuradas con ingredientes, pasos y temporizadores."
  active="recetas"
>
  <div class="px-4 py-8 sm:px-8 lg:px-10 max-w-7xl mx-auto space-y-12">
    <section class="text-center md:text-left select-none">
      <p
        class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]"
      >
        Catálogo
      </p>
      <h1
        class="font-handwritten mt-2 text-4xl sm:text-5xl font-black tracking-tight text-[var(--text)]"
      >
        Recetas de Ejemplo en Recetario IA
      </h1>
      <p class="font-handwritten text-lg text-[var(--muted)] mt-2 max-w-2xl">
        Colecciones de recetas seleccionadas con formato Polaroid clásico y pasos explicados.
      </p>
    </section>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        recipes.map((recipe, index) => {
          const image = getRecipeImageUrl(
            recipe.data.title,
            recipe.data.ingredients.map((i) => i.item),
          );
          // Alternating rotations to simulate scattered Polaroids
          const rotations = [
            "rotate-[-1.5deg] hover:rotate-0",
            "rotate-[1.2deg] hover:rotate-0",
            "rotate-[-1deg] hover:rotate-0",
            "rotate-[1.5deg] hover:rotate-0",
            "rotate-[-0.8deg] hover:rotate-0",
          ];
          const rotationClass = rotations[index % rotations.length];
          const isLcp = index === 0;

          return (
            <a
              href={`/recetas/${recipe.id}`}
              class={`polaroid block group bg-white shadow-[4px_4px_0px_rgba(0,0,0,0.12)] border border-black/5 p-4 sm:p-5 transition-all duration-300 ${rotationClass} hover:scale-105`}
            >
              <div class="overflow-hidden bg-slate-100 relative">
                <img
                  src={image}
                  alt={`Receta de ${recipe.data.title}`}
                  width="360"
                  height="192"
                  class="h-48 w-full object-cover transition duration-300 grayscale-[8%] sepia-[4%] group-hover:scale-105"
                  loading={isLcp ? "eager" : "lazy"}
                  fetchpriority={isLcp ? "high" : "auto"}
                  decoding="async"
                />
                <span class="absolute top-2 right-2 shrink-0 rounded bg-white/90 border border-black/10 px-2 py-0.5 text-[0.625rem] font-mono font-bold text-[var(--text)] select-none uppercase shadow-sm">
                  {recipe.data.difficulty}
                </span>
              </div>
              <div class="pt-4 flex flex-col gap-2">
                <h2 class="font-handwritten text-xl font-bold text-[var(--text)] truncate">
                  {recipe.data.title}
                </h2>
                <p class="font-handwritten text-sm text-[var(--muted)] line-clamp-2 h-10">
                  {recipe.data.description}
                </p>
                <div class="mt-2 flex flex-wrap gap-2 text-xs font-mono font-bold text-[var(--muted)]">
                  <span>
                    {recipe.data.prepMinutes + recipe.data.cookMinutes} MIN
                  </span>
                  <span>·</span>
                  <span>{recipe.data.servings} RACIONES</span>
                </div>
                {recipe.data.tags && recipe.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5 border-t border-dashed border-[var(--border)] pt-3">
                    {recipe.data.tags.slice(0, 3).map((tag) => (
                      <span class="font-handwritten text-xs text-[var(--text)]/80 relative px-2.5 py-0.5 bg-amber-100/60 shadow-[0_1px_1px_rgba(0,0,0,0.05)] border border-black/5 rotate-[1deg]">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Casos de Éxito, Testimonios y FAQ del Catálogo -->
    <div class="space-y-8 pt-6">
      <section
        class="notebook-paper p-6 sm:p-8 rounded-lg border border-dashed border-[var(--border)]"
        aria-label="Casos de éxito y opiniones del catálogo"
      >
        <div class="mb-4 border-b border-dashed border-[var(--border)] pb-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]">Casos de Éxito y Testimonios</span>
          <h2 class="font-handwritten text-2xl sm:text-3xl font-black text-[var(--text)] mt-1">
            Recetas probadas y valoradas por la comunidad
          </h2>
          <p class="font-handwritten text-sm text-[var(--muted)] mt-1">
            Portafolio de recetas, proyectos realizados y opiniones de clientes verificadas con experiencia demostrada.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <blockquote class="p-4 rounded bg-white/40 border border-[var(--border)]/60">
            <p class="font-handwritten text-sm text-[var(--text)]/90">"La receta de pollo al limón quedó perfecta. Los tiempos de cocción son exactos y la explicación inmejorable."</p>
            <footer class="mt-2 text-xs font-mono font-bold text-[var(--muted)]">— Marta R. (Cliente verificado) ★★★★★</footer>
          </blockquote>
          <blockquote class="p-4 rounded bg-white/40 border border-[var(--border)]/60">
            <p class="font-handwritten text-sm text-[var(--text)]/90">"Ideal para preparar cenas saludables entre semana sin perder tiempo buscando ideas."</p>
            <footer class="mt-2 text-xs font-mono font-bold text-[var(--muted)]">— David P. (Cliente verificado) ★★★★★</footer>
          </blockquote>
        </div>
      </section>

      <section
        class="notebook-paper p-6 sm:p-8 rounded-lg border border-dashed border-[var(--border)]"
        aria-labelledby="faq-catalog-heading"
      >
        <div class="mb-4 border-b border-dashed border-[var(--border)] pb-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent)]">Preguntas Frecuentes</span>
          <h2 id="faq-catalog-heading" class="font-handwritten text-2xl sm:text-3xl font-black text-[var(--text)] mt-1">
            Preguntas frecuentes sobre el catálogo
          </h2>
        </div>
        <div class="space-y-3">
          <div class="p-3 rounded bg-white/40 border border-[var(--border)]/60">
            <h3 class="font-handwritten text-base font-bold text-[var(--text)]">¿Cómo puedo cocinar una receta del catálogo?</h3>
            <p class="font-handwritten text-sm text-[var(--text)]/80 mt-1">Haz clic en cualquier ficha para ver los ingredientes completos y activar el Modo Cocinar paso a paso con temporizadores.</p>
          </div>
          <div class="p-3 rounded bg-white/40 border border-[var(--border)]/60">
            <h3 class="font-handwritten text-base font-bold text-[var(--text)]">¿Puedo añadir mis propios ingredientes?</h3>
            <p class="font-handwritten text-sm text-[var(--text)]/80 mt-1">Sí, accede a la sección Generar Receta para crear una receta totalmente personalizada a partir de lo que tengas en tu nevera.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
