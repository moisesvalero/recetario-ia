---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.svelte";
import AuthModal from "../components/AuthModal.svelte";

interface Props {
  title?: string;
  active?: "home" | "recetas";
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Genera recetas con IA a partir de lo que tienes en la nevera."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title ?? "Recetario IA"}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)]">
    <div class="flex min-h-screen">
      <Sidebar client:load />

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex items-center justify-between border-b border-[var(--border)] bg-white/80 px-4 py-3 backdrop-blur lg:hidden"
        >
          <a href="/" class="font-bold">Recetario IA</a>
          <nav class="flex gap-3 text-sm text-[var(--muted)]">
            <a href="/">Generar</a>
            <a href="/recetas">Recetas</a>
          </nav>
        </header>
        <main class="flex-1">
          <slot />
        </main>
      </div>
    </div>
    <AuthModal client:load />
  </body>
</html>
