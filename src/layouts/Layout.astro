---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.svelte";
import AuthModal from "../components/AuthModal.svelte";

interface Props {
  title?: string;
  active?: "home" | "recetas";
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Genera recetas con IA a partir de lo que tienes en la nevera."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title ?? "Umami — Tu Chef Inteligente"}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)] font-body text-[var(--text)]">
    <div class="flex min-h-screen">
      <Sidebar client:load />

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex items-center justify-between border-b border-dashed border-[var(--border)] bg-[var(--surface-muted)] px-6 py-3.5 lg:hidden z-30"
        >
          <a
            href="/"
            class="font-handwritten text-2xl font-black text-[var(--text)]"
            >Umami</a
          >
          <nav
            class="flex gap-4 text-xs font-bold font-mono text-[var(--muted)]"
          >
            <a href="/" class="hover:text-[var(--accent)] transition-colors"
              >GENERAR</a
            >
            <a
              href="/recetas"
              class="hover:text-[var(--accent)] transition-colors">RECETAS</a
            >
          </nav>
        </header>
        <main class="flex-1">
          <slot />
        </main>
      </div>
    </div>
    <AuthModal client:load />
  </body>
</html>
