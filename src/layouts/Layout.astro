---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.svelte";
import MobileHeader from "../components/MobileHeader.svelte";
import AuthModal from "../components/AuthModal.svelte";

interface Props {
  title?: string;
  active?: "home" | "recetas";
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Genera recetas con IA a partir de lo que tienes en la nevera."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title ?? "Umami — Tu Chef Inteligente"}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)] font-body text-[var(--text)]">
    <div class="flex min-h-screen">
      <Sidebar client:load />

      <div class="flex min-w-0 flex-1 flex-col">
        <MobileHeader client:load />
        <main class="flex-1">
          <slot />
        </main>
      </div>
    </div>
    <AuthModal client:load />
  </body>
</html>
