---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Genera recetas con IA a partir de lo que tienes en la nevera."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ?? "Recetario IA"}</title>
  </head>
  <body>
    <header
      class="border-b border-[var(--border)] bg-[var(--surface)]/90 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
      >
        <a href="/" class="text-lg font-semibold tracking-tight">Recetario IA</a
        >
        <nav class="flex items-center gap-4 text-sm text-[var(--muted)]">
          <a href="/" class="hover:text-[var(--text)]">Generar</a>
          <a href="/recetas" class="hover:text-[var(--text)]"
            >Recetas de ejemplo</a
          >
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>
